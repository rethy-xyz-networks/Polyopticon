# App data
# Polyopticon keeps everything it stores outside the repository, in
# %LocalAppData%\Polyopticon (database, saved pages, logins) and %AppData%\Polyopticon
# (browser cookies). These patterns catch a copy run with POLYOPTICON_DATA_DIR
# pointing inside the repo, so personal data and logins never get committed.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.mhtml
accounts.bin
scratchpad.bin
adblock-lists.bin
/browser/
/logs/
/models/
/snapshots/
/icons/
/settings.json
/tags.json
/ui.json
/pinned.json

# Benchmark recordings (scripts/bench-polling/record.js): large, and regenerated by running it
/bench-data/

# Node / Electron debugging and packaging leftovers
*.tgz
.node_repl_history
*.cpuprofile
*.heapsnapshot
.cache/


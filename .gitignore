# App data
# Polyopticon keeps everything it stores outside the repository, in
# %LocalAppData%\Polyopticon (database, saved pages, logins) and %AppData%\Polyopticon
# (browser cookies). These patterns catch a copy run with POLYOPTICON_DATA_DIR
# pointing inside the repo, so personal data and logins never get committed.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.mhtml
accounts.bin
adblock-lists.bin
/logs/
/models/
/snapshots/
/icons/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache

# OS clutter
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code: per-user settings and notes (shared .claude/ files are fine)
.claude/settings.local.json
CLAUDE.local.md

